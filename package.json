{
  "name": "rowport",
  "version": "1.0.0",
  "description": "A modern desktop client for multi-database workflow",
  "main": "./dist/main/index.js",
  "author": "nghiaxh",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build:main && pnpm build:preload && pnpm build:renderer && playwright test",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.node.json",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/preload/index.js --external:electron",
    "build:renderer": "vite build",
    "build": "pnpm run typecheck && pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@lezer/highlight": "^1.2.3",
    "@napi-rs/keyring": "^1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.3",
    "better-sqlite3": "^13.0.3",
    "bson": "^7.3.2",
    "electron-updater": "^6.3.9",
    "electron-window-state": "^5.0.3",
    "framer-motion": "^13.1.0",
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "sql-formatter": "^15.8.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testcontainers/mongodb": "^12.1.0",
    "@testcontainers/mysql": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "code-inspector-plugin": "^2.0.7",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  }
}
